# Supabase — variables para CLI y edge functions.
# Copiar a .env (no commitear). Solo se usan en el entorno de admin/CI.

# Proyecto hosted (vacios si solo trabajas local con `supabase start`)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Claves del proyecto (Dashboard -> Project Settings -> API)
# URL = https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret JWT (para verificar tokens en edge functions, si haces verificacion manual)
SUPABASE_JWT_SECRET=

# Storage / buckets — no requieren env por defecto.

# Opcionales para edge functions
RESEND_API_KEY=
SENTRY_DSN=
