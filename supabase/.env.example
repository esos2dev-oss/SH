# Supabase — variables para CLI y edge functions.
# Copiar a .env (no commitear). Solo se usan en el entorno de admin/CI.

# Proyecto hosted (vacios si solo trabajas local con `supabase start`)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Claves del proyecto (Dashboard -> Project Settings -> API)
# URL = https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret JWT (para verificar tokens en edge functions, si haces verificacion manual)
SUPABASE_JWT_SECRET=

# Storage / buckets — no requieren env por defecto.

# Opcionales para edge functions
RESEND_API_KEY=
SENTRY_DSN=

# --- Stripe (suscripciones) ---
# SOLO servidor. Nunca en variables VITE_*, que acaban en el bundle publico.
STRIPE_SECRET_KEY=
# Secreto del webhook (Dashboard -> Developers -> Webhooks -> Signing secret).
# Sin el, cualquiera que conozca la URL se regala una suscripcion.
STRIPE_WEBHOOK_SECRET=

# URL publica de la app, para las vueltas de Checkout y del portal.
APP_URL=http://localhost:5173/sh
# Origenes permitidos por CORS en las funciones de cobro, separados por comas.
# Estas funciones NO usan el '*' del resto: mueven dinero.
APP_ORIGINS=http://localhost:5173
