# =============================================================================
# Sistema Hotelero — Backend (.env)
# Copiar a .env y rellenar. NUNCA commitear el .env real.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
APP_URL=http://localhost:5173/sh
API_URL=http://localhost:3002

# --- Database ---
# Local: postgres://sh_user:sh_pass@localhost:5432/sh_db
DATABASE_URL=postgres://sh_user:CHANGE_ME@localhost:5432/sh_db

# --- Auth ---
# Generar secrets con: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_64_CHARS_MIN
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Cloudflare R2 (storage) ---
R2_ACCOUNT_ID=TODO_PEDIR_AL_CLIENTE
R2_ACCESS_KEY_ID=TODO
R2_SECRET_ACCESS_KEY=TODO
R2_BUCKET=sh-dev
R2_ENDPOINT=https://TODO.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# --- Resend (email) ---
RESEND_API_KEY=TODO_GENERAR_EN_RESEND_DASHBOARD
EMAIL_FROM="Hotel <noreply@TODO-DOMINIO.com>"
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=TODO

# --- Sentry ---
SENTRY_DSN=

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Rate limit login ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Hotel (defaults — sobreescritos por tabla settings cuando exista) ---
HOTEL_NAME=Sistema Hotelero
HOTEL_CURRENCY=USD
HOTEL_TIMEZONE=America/Caracas
