# Frontend — Sistema Hotelero
# Copiar a .env y completar.

# URL publica del proyecto Supabase
# - Local (supabase start): http://127.0.0.1:54321
# - Hosted: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Anon key (publica, segura para el frontend gracias a RLS)
# La encuentras en: supabase status (local) o Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# Branding
VITE_APP_NAME=Sistema Hotelero
